ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('AMAC unit cube'),'2;1');
FILE_NAME('cube.step','2026-09-15',('AMAC'),(''),
  'STEP AP203','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

/* ── Coordinate system ── */
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=DIRECTION('',(0.,0.,1.));
#3=DIRECTION('',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);

/* ── 8 vertices ── */
#10=CARTESIAN_POINT('v0',(0.,0.,0.));
#11=CARTESIAN_POINT('v1',(1.,0.,0.));
#12=CARTESIAN_POINT('v2',(1.,1.,0.));
#13=CARTESIAN_POINT('v3',(0.,1.,0.));
#14=CARTESIAN_POINT('v4',(0.,0.,1.));
#15=CARTESIAN_POINT('v5',(1.,0.,1.));
#16=CARTESIAN_POINT('v6',(1.,1.,1.));
#17=CARTESIAN_POINT('v7',(0.,1.,1.));

#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
#24=VERTEX_POINT('v4',#14);
#25=VERTEX_POINT('v5',#15);
#26=VERTEX_POINT('v6',#16);
#27=VERTEX_POINT('v7',#17);

/* ── Direction vectors for edges ── */
#30=DIRECTION('',( 1., 0., 0.));
#31=DIRECTION('',( 0., 1., 0.));
#32=DIRECTION('',( 0., 0., 1.));
#33=DIRECTION('',(-1., 0., 0.));
#34=DIRECTION('',( 0.,-1., 0.));
#35=DIRECTION('',( 0., 0.,-1.));

/* ── 12 edge curves (LINE) ──
     Bottom face (z=0): e1..e4
     Top face (z=1):    e5..e8
     Verticals:         e9..e12 */

/* bottom: v0-v1 */
#40=LINE('',#10,#100);
#100=VECTOR('',#30,1.);
#41=EDGE_CURVE('e1',#20,#21,#40,.T.);

/* bottom: v1-v2 */
#42=LINE('',#11,#101);
#101=VECTOR('',#31,1.);
#43=EDGE_CURVE('e2',#21,#22,#42,.T.);

/* bottom: v2-v3 */
#44=LINE('',#12,#102);
#102=VECTOR('',#33,1.);
#45=EDGE_CURVE('e3',#22,#23,#44,.T.);

/* bottom: v3-v0 */
#46=LINE('',#13,#103);
#103=VECTOR('',#34,1.);
#47=EDGE_CURVE('e4',#23,#20,#46,.T.);

/* top: v4-v5 */
#48=LINE('',#14,#104);
#104=VECTOR('',#30,1.);
#49=EDGE_CURVE('e5',#24,#25,#48,.T.);

/* top: v5-v6 */
#50=LINE('',#15,#105);
#105=VECTOR('',#31,1.);
#51=EDGE_CURVE('e6',#25,#26,#50,.T.);

/* top: v6-v7 */
#52=LINE('',#16,#106);
#106=VECTOR('',#33,1.);
#53=EDGE_CURVE('e7',#26,#27,#52,.T.);

/* top: v7-v4 */
#54=LINE('',#17,#107);
#107=VECTOR('',#34,1.);
#55=EDGE_CURVE('e8',#27,#24,#54,.T.);

/* vertical: v0-v4 */
#56=LINE('',#10,#108);
#108=VECTOR('',#32,1.);
#57=EDGE_CURVE('e9',#20,#24,#56,.T.);

/* vertical: v1-v5 */
#58=LINE('',#11,#109);
#109=VECTOR('',#32,1.);
#59=EDGE_CURVE('e10',#21,#25,#58,.T.);

/* vertical: v2-v6 */
#60=LINE('',#12,#110);
#110=VECTOR('',#32,1.);
#61=EDGE_CURVE('e11',#22,#26,#60,.T.);

/* vertical: v3-v7 */
#62=LINE('',#13,#111);
#111=VECTOR('',#32,1.);
#63=EDGE_CURVE('e12',#23,#27,#62,.T.);

/* ── Oriented edges for each face ── */

/* Face 1: z=0 bottom (v0-v1-v2-v3, outward normal -Z) */
#70=ORIENTED_EDGE('',*,*,#41,.F.);
#71=ORIENTED_EDGE('',*,*,#47,.F.);
#72=ORIENTED_EDGE('',*,*,#45,.F.);
#73=ORIENTED_EDGE('',*,*,#43,.F.);

/* Face 2: z=1 top (v4-v5-v6-v7, outward normal +Z) */
#74=ORIENTED_EDGE('',*,*,#49,.T.);
#75=ORIENTED_EDGE('',*,*,#51,.T.);
#76=ORIENTED_EDGE('',*,*,#53,.T.);
#77=ORIENTED_EDGE('',*,*,#55,.T.);

/* Face 3: y=0 front (v0-v1-v5-v4, outward normal -Y) */
#78=ORIENTED_EDGE('',*,*,#41,.T.);
#79=ORIENTED_EDGE('',*,*,#59,.T.);
#80=ORIENTED_EDGE('',*,*,#49,.F.);
#81=ORIENTED_EDGE('',*,*,#57,.F.);

/* Face 4: x=1 right (v1-v2-v6-v5, outward normal +X) */
#82=ORIENTED_EDGE('',*,*,#43,.T.);
#83=ORIENTED_EDGE('',*,*,#61,.T.);
#84=ORIENTED_EDGE('',*,*,#51,.F.);
#85=ORIENTED_EDGE('',*,*,#59,.F.);

/* Face 5: y=1 back (v2-v3-v7-v6, outward normal +Y) */
#86=ORIENTED_EDGE('',*,*,#45,.T.);
#87=ORIENTED_EDGE('',*,*,#63,.T.);
#88=ORIENTED_EDGE('',*,*,#53,.F.);
#89=ORIENTED_EDGE('',*,*,#61,.F.);

/* Face 6: x=0 left (v3-v0-v4-v7, outward normal -X) */
#90=ORIENTED_EDGE('',*,*,#47,.T.);
#91=ORIENTED_EDGE('',*,*,#57,.T.);
#92=ORIENTED_EDGE('',*,*,#55,.F.);
#93=ORIENTED_EDGE('',*,*,#63,.F.);

/* ── Edge loops ── */
#120=EDGE_LOOP('',(#70,#71,#72,#73));
#121=EDGE_LOOP('',(#74,#75,#76,#77));
#122=EDGE_LOOP('',(#78,#79,#80,#81));
#123=EDGE_LOOP('',(#82,#83,#84,#85));
#124=EDGE_LOOP('',(#86,#87,#88,#89));
#125=EDGE_LOOP('',(#90,#91,#92,#93));

/* ── Face bounds ── */
#130=FACE_OUTER_BOUND('',#120,.T.);
#131=FACE_OUTER_BOUND('',#121,.T.);
#132=FACE_OUTER_BOUND('',#122,.T.);
#133=FACE_OUTER_BOUND('',#123,.T.);
#134=FACE_OUTER_BOUND('',#124,.T.);
#135=FACE_OUTER_BOUND('',#125,.T.);

/* ── Surface geometry (PLANEs) ── */
/* z=0 bottom: origin (0,0,0), normal -Z */
#140=CARTESIAN_POINT('',(0.,0.,0.));
#141=DIRECTION('',(0.,0.,-1.));
#142=DIRECTION('',(1.,0.,0.));
#143=AXIS2_PLACEMENT_3D('',#140,#141,#142);
#144=PLANE('',#143);

/* z=1 top: origin (0,0,1), normal +Z */
#145=CARTESIAN_POINT('',(0.,0.,1.));
#146=DIRECTION('',(0.,0.,1.));
#147=DIRECTION('',(1.,0.,0.));
#148=AXIS2_PLACEMENT_3D('',#145,#146,#147);
#149=PLANE('',#148);

/* y=0 front: origin (0,0,0), normal -Y */
#150=CARTESIAN_POINT('',(0.,0.,0.));
#151=DIRECTION('',(0.,-1.,0.));
#152=DIRECTION('',(1.,0.,0.));
#153=AXIS2_PLACEMENT_3D('',#150,#151,#152);
#154=PLANE('',#153);

/* x=1 right: origin (1,0,0), normal +X */
#155=CARTESIAN_POINT('',(1.,0.,0.));
#156=DIRECTION('',(1.,0.,0.));
#157=DIRECTION('',(0.,1.,0.));
#158=AXIS2_PLACEMENT_3D('',#155,#156,#157);
#159=PLANE('',#158);

/* y=1 back: origin (0,1,0), normal +Y */
#160=CARTESIAN_POINT('',(0.,1.,0.));
#161=DIRECTION('',(0.,1.,0.));
#162=DIRECTION('',(1.,0.,0.));
#163=AXIS2_PLACEMENT_3D('',#160,#161,#162);
#164=PLANE('',#163);

/* x=0 left: origin (0,0,0), normal -X */
#165=CARTESIAN_POINT('',(0.,0.,0.));
#166=DIRECTION('',(-1.,0.,0.));
#167=DIRECTION('',(0.,1.,0.));
#168=AXIS2_PLACEMENT_3D('',#165,#166,#167);
#169=PLANE('',#168);

/* ── Advanced faces ── */
#170=ADVANCED_FACE('bottom',(#130),#144,.T.);
#171=ADVANCED_FACE('top',(#131),#149,.T.);
#172=ADVANCED_FACE('front',(#132),#154,.T.);
#173=ADVANCED_FACE('right',(#133),#159,.T.);
#174=ADVANCED_FACE('back',(#134),#164,.T.);
#175=ADVANCED_FACE('left',(#135),#169,.T.);

/* ── Shell and solid ── */
#180=CLOSED_SHELL('',(#170,#171,#172,#173,#174,#175));
#181=MANIFOLD_SOLID_BREP('cube',#180);

/* ── Shape representation ── */
#190=ADVANCED_BREP_SHAPE_REPRESENTATION('cube',(#181,#4),#191);
#191=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
       GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#192))
       GLOBAL_UNIT_ASSIGNED_CONTEXT((#193,#194,#195))
       REPRESENTATION_CONTEXT('','3D') );
#192=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#193,
  'distance accuracy','');
#193=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#194=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#195=( NAMED_UNIT(*) SOLID_ANGLE_UNIT() SI_UNIT($,.STERADIAN.) );

/* ── Product definition ── */
#200=PRODUCT('cube','unit cube','',(#201));
#201=PRODUCT_CONTEXT('',#202,'mechanical');
#202=APPLICATION_CONTEXT('configuration controlled 3D design');
#203=PRODUCT_DEFINITION_FORMATION('','',#200);
#204=PRODUCT_DEFINITION('design','',#203,#205);
#205=PRODUCT_DEFINITION_CONTEXT('part definition',#202,'design');
#206=PRODUCT_DEFINITION_SHAPE('','',#204);
#207=SHAPE_DEFINITION_REPRESENTATION(#206,#190);

ENDSEC;
END-ISO-10303-21;
